#!/bin/bash
set -euo pipefail

ESP=${ESP:-/boot/efi}
BOOTROOT=${BOOTROOT:-/boot}
SYSROOT=${SYSROOT:-/}
BACKEND=${BACKEND:-/usr/libexec/armada/armada-boot-backend}
ARGS_FILE=${ARGS_FILE:-/usr/lib/armada/bootimg-args}
CMDLINE=${CMDLINE:-/proc/cmdline}

ESP=${ESP} "${BACKEND}" is efi || exit 0
findmnt -rn "${ESP}" >/dev/null
. "${ARGS_FILE}"

entry=$(armada_default_bls_entry "${BOOTROOT}")
[ -n "${entry}" ]
options=$(sed -n 's/^options //p' "${entry}" | head -1)
ostree=
for arg in ${options}; do
    case "${arg}" in ostree=*) ostree=${arg#ostree=} ;; esac
done
[ -n "${ostree}" ]
deploy=$(realpath -e "${SYSROOT%/}${ostree}")
default_version=$(cat "${deploy}/usr/lib/armada/version")
[ -n "${default_version}" ]
loader=${deploy}/usr/lib/systemd/boot/efi/systemd-bootaa64.efi
ext4=${deploy}/usr/share/edk2/drivers/ext4aa64.efi
adtbloader=${deploy}/usr/lib/armada/efi/drivers/adtbloaderaa64.efi
armada_boot=${deploy}/usr/lib/armada/efi/armada-boot.efi
dtb_list=${deploy}/usr/lib/armada/supported-dtbs
for file in "${loader}" "${ext4}" "${adtbloader}" "${armada_boot}"; do
    [ -s "${file}" ]
done
[ -s "${dtb_list}" ]

choice=
for arg in $(cat "${CMDLINE}" 2>/dev/null || true); do
    case "${arg}" in armada.device=*) choice=${arg#armada.device=} ;; esac
done
selected=
if [ -z "${choice}" ] && [ -s "${ESP}/armada/device" ]; then
    read -r choice < "${ESP}/armada/device"
fi
if [ "${choice}" != auto ] && grep -Fxq "${choice}" "${dtb_list}"; then
    selected=${choice}
fi

mapfile -t entries < <(find "${BOOTROOT}/loader/entries" -maxdepth 1 -name '*.conf' ! -name '*-dtb-*.conf' -type f | sort)
[ "${#entries[@]}" -gt 0 ]
rollback=$(
    for file in "${entries[@]}"; do
        [ "${file}" != "${entry}" ] || continue
        version=$(sed -n 's/^version //p' "${file}" | head -1)
        printf '%s\t%s\n' "${version:-0}" "${file}"
    done | sort -rn | head -1 | cut -f2
)
rollback_ready=
if [ -n "${rollback}" ]; then
    rollback_entry=${rollback##*/}
    rollback_options=$(sed -n 's/^options //p' "${rollback}" | head -1)
    rollback_ostree=
    for arg in ${rollback_options}; do
        case "${arg}" in ostree=*) rollback_ostree=${arg#ostree=} ;; esac
    done
    rollback_linux=$(sed -n 's/^linux //p' "${rollback}" | head -1)
    rollback_linux=${rollback_linux#/boot}
    rollback_dtbs=$(dirname "${rollback_linux}")/dtb/qcom
    rollback_deploy=
    if [ -n "${rollback_ostree}" ]; then
        rollback_deploy=$(realpath -e "${SYSROOT%/}${rollback_ostree}" 2>/dev/null || true)
    fi
    rollback_version=
    if [ -n "${rollback_deploy}" ] && [ -r "${rollback_deploy}/usr/lib/armada/version" ]; then
        rollback_version=$(cat "${rollback_deploy}/usr/lib/armada/version")
    fi
    if [ -n "${rollback_version}" ] && [ -d "${BOOTROOT}${rollback_dtbs}" ]; then
        if [ -z "${selected}" ] || [ -f "${BOOTROOT}${rollback_dtbs}/${selected}.dtb" ]; then
            rollback_ready=1
        fi
    fi
fi
linux=$(sed -n 's/^linux //p' "${entry}" | head -1)
linux=${linux#/boot}
while read -r name; do
    dtb=${BOOTROOT}$(dirname "${linux}")/dtb/qcom/${name}.dtb
    [ -f "${dtb}" ]
    model=$(fdtget -t s "${dtb}" / model)
done < "${dtb_list}"

copy() {
    mkdir -p "$(dirname "$2")"
    cmp -s "$1" "$2" && return 0
    cp -f "$1" "$2.new"
    sync "$2.new"
    mv -f "$2.new" "$2"
}

copy "${armada_boot}" "${ESP}/EFI/BOOT/BOOTAA64.EFI"
copy "${armada_boot}" "${ESP}/EFI/Microsoft/Boot/bootmgfw.efi"
copy "${adtbloader}" "${ESP}/EFI/BOOT/drivers_aa64/adtbloaderaa64.efi"
copy "${loader}" "${ESP}/EFI/systemd/systemd-bootaa64.efi"
copy "${ext4}" "${ESP}/EFI/systemd/drivers/ext4aa64.efi"
rm -f "${ESP}/EFI/BOOT/refind.conf" \
    "${ESP}/EFI/BOOT/fbaa64.efi" \
    "${ESP}/EFI/BOOT/BOOTAA64.CSV" \
    "${ESP}/EFI/BOOT/grub.cfg" \
    "${ESP}/EFI/BOOT/grubaa64.efi" \
    "${ESP}/EFI/systemd/drivers/adtbloaderaa64.efi" \
    "${ESP}/EFI/systemd/drivers/dtbloaderaa64.efi"
rm -rf "${ESP}/EFI/BOOT/theme" "${ESP}/EFI/refind" "${ESP}/EFI/fedora"
rm -rf "${BOOTROOT}/grub2"

linux=$(sed -n 's/^linux //p' "${entry}" | head -1)
linux=${linux#/boot}
dtbs=${BOOTROOT}$(dirname "${linux}")/dtb/qcom
for dtb in "${dtbs}"/*.dtb; do
    [ -f "${dtb}" ]
    copy "${dtb}" "${ESP}/dtbloader/dtbs/qcom/${dtb##*/}"
done
for dtb in "${ESP}/dtbloader/dtbs/qcom"/*.dtb; do
    [ -e "${dtb}" ] || continue
    [ -f "${dtbs}/${dtb##*/}" ] || rm -f "${dtb}"
done

rm -f "${BOOTROOT}/loader/entries"/*-dtb-*.conf
for file in "${entries[@]}"; do
    linux=$(sed -n 's/^linux //p' "${file}" | head -1)
    linux=${linux#/boot}
    dtb=${BOOTROOT}$(dirname "${linux}")/dtb/qcom/${selected:-}.dtb

    # Keep suppressed deployments as BLS files so a later device selection can
    # reconsider them. systemd-boot hides entries for a foreign architecture.
    if [ -n "${selected}" ] && [ -f "${dtb}" ]; then
        if [ "${file}" = "${entry}" ]; then
            title='Armada OS'
        else
            title='Armada OS (Previous Version)'
        fi
        sed -e "s|^title .*|title ${title}|" \
            -e 's|^linux /boot/|linux /|' -e 's|^initrd /boot/|initrd /|' \
            -e '/^fdtdir /d' -e '/^devicetree /d' \
            -e '/^architecture armada-hidden$/d' -e 's/ armada\.device=[^ ]*//g' \
            -e "s|^options |options armada.device=${selected} |" \
            "${file}" > "${file}.new"
        printf 'devicetree %s/dtb/qcom/%s.dtb\n' \
            "$(dirname "${linux}")" "${selected}" >> "${file}.new"
        mv -f "${file}.new" "${file}"
    elif [ -z "${selected}" ] && [ "${file}" = "${entry}" ]; then
        sed -e 's|^title .*|title Armada OS (Automatic)|' \
            -e 's|^linux /boot/|linux /|' -e 's|^initrd /boot/|initrd /|' \
            -e '/^fdtdir /d' \
            -e '/^devicetree /d' -e '/^architecture armada-hidden$/d' \
            -e 's/ armada\.device=[^ ]*//g' -e 's|^options |options armada.device=auto |' \
            "${file}" > "${file}.new"
        mv -f "${file}.new" "${file}"
        while read -r name; do
            dtb=${BOOTROOT}$(dirname "${linux}")/dtb/qcom/${name}.dtb
            [ -f "${dtb}" ] || continue
            model=$(fdtget -t s "${dtb}" / model)
            device=${file%.conf}-dtb-${name}.conf
            sed -e "s|^title .*|title Armada OS - ${model}|" \
                -e "s|armada.device=auto|armada.device=${name}|" "${file}" > "${device}.new"
            printf 'devicetree %s/dtb/qcom/%s.dtb\n' \
                "$(dirname "${linux}")" "${name}" >> "${device}.new"
            mv -f "${device}.new" "${device}"
        done < "${dtb_list}"
    elif [ -z "${selected}" ] && [ "${file}" = "${rollback}" ] && [ -n "${rollback_ready}" ]; then
        sed -e 's|^title .*|title Armada OS (Previous Version)|' \
            -e 's|^linux /boot/|linux /|' -e 's|^initrd /boot/|initrd /|' \
            -e '/^fdtdir /d' -e '/^devicetree /d' \
            -e '/^architecture armada-hidden$/d' -e 's/ armada\.device=[^ ]*//g' \
            -e 's|^options |options armada.device=auto |' \
            "${file}" > "${file}.new"
        mv -f "${file}.new" "${file}"
    else
        # Hide deployments that cannot boot the selected device.
        sed -e 's|^linux /boot/|linux /|' -e 's|^initrd /boot/|initrd /|' \
            -e '/^architecture armada-hidden$/d' "${file}" > "${file}.new"
        printf 'architecture armada-hidden\n' >> "${file}.new"
        mv -f "${file}.new" "${file}"
    fi
done

mkdir -p "${ESP}/armada" "${ESP}/loader/entries" "${ESP}/ostree"
for file in "${ESP}/ostree"/*; do
    [ ! -e "${file}" ] || [ -e "${BOOTROOT}/ostree/${file##*/}" ] || rm -rf "${file}"
done
while IFS= read -r -d '' file; do
    copy "${file}" "${ESP}/${file#"${BOOTROOT}/"}"
done < <(find "${BOOTROOT}/ostree" -type f -print0)
for file in "${BOOTROOT}/loader/entries"/*.conf; do
    copy "${file}" "${ESP}/loader/entries/${file##*/}"
done
for file in "${ESP}/loader/entries"/*.conf; do
    [ ! -e "${file}" ] || [ -e "${BOOTROOT}/loader/entries/${file##*/}" ] || rm -f "${file}"
done
{
    printf 'ARMADA_BOOT_BACKEND=efi\nARMADA_BOOT_CONTRACT=1\n'
    printf 'ARMADA_DEFAULT_VERSION=%s\n' "${default_version}"
    if [ -n "${rollback_ready}" ]; then
        printf 'ARMADA_ROLLBACK_ENTRY=%s\n' "${rollback_entry}"
        printf 'ARMADA_ROLLBACK_VERSION=%s\n' "${rollback_version}"
        printf 'ARMADA_ROLLBACK_DTBS=%s\n' "${rollback_dtbs}"
    fi
} > "${ESP}/armada/backend.conf"
if [ -n "${selected}" ]; then
    printf '%s\n' "${selected}" > "${ESP}/armada/device"
else
    rm -f "${ESP}/armada/device"
fi
printf 'default %s\ntimeout menu-hidden\neditor no\n' \
    "${entry##*/}" > "${ESP}/loader/loader.conf"
sync
