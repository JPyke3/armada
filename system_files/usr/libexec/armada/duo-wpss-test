#!/bin/bash
set -euo pipefail

grep -zqx 'retroidpocket,duo' /sys/firmware/devicetree/base/compatible || exit 0

marker=/var/lib/armada-duo-wpss/attempted-v1
report=/var/home/armada/duo-wpss-test.txt
firmware=qcom/sm7750/retroidpocket/duo/wpss.mdt
[[ ! -e "$marker" ]] || exit 0

exec > >(tee "$report") 2>&1
printf 'Duo WPSS test v1; boot ID: %s\n' "$(cat /proc/sys/kernel/random/boot_id)"
uname -r
trap 'result=$?; printf "Test exit status: %s\n" "$result"; journalctl -b -k --no-pager; sync' EXIT

modprobe qcom_q6v5_pas
shopt -s nullglob
matches=()
for ((attempt = 0; attempt < 20; attempt++)); do
    matches=()
    for device in /sys/class/remoteproc/remoteproc*; do
        [[ -r "$device/firmware" ]] || continue
        [[ "$(cat "$device/firmware")" == "$firmware" ]] && matches+=("$device")
    done
    ((${#matches[@]} > 0)) && break
    sleep 1
done

if ((${#matches[@]} != 1)); then
    printf 'Expected one WPSS device; found %s. No firmware started.\n' "${#matches[@]}"
    exit 1
fi

device=${matches[0]}
state=$(cat "$device/state")
printf 'WPSS: %s; initial state: %s\n' "$device" "$state"
if [[ "$state" != offline ]]; then
    printf 'Unexpected initial state; no firmware started.\n'
    exit 1
fi

printf 'Attempting WPSS startup once.\n'
printf 'disabled\n' > "$device/recovery"
printf 'Automatic WPSS recovery disabled for this test.\n'
printf '%s\n' "$(cat /proc/sys/kernel/random/boot_id)" > "$marker"
sync
printf 'start\n' > "$device/state"
printf 'State after start: %s\n' "$(cat "$device/state")"
sleep 15
state=$(cat "$device/state")
printf 'State after 15 seconds: %s\n' "$state"
[[ "$state" == running ]]
