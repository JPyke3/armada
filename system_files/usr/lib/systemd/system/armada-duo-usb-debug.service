# TEMP(duo): USB debug gadget for bring-up; remove before release.
[Unit]
Description=Retroid Pocket Duo USB debug gadget (NCM + ACM)
After=local-fs.target systemd-modules-load.service NetworkManager.service
Conflicts=armada-mtp.service
RequiresMountsFor=/var/home/armada
ConditionPathExists=/sys/firmware/devicetree/base/compatible

[Service]
Type=oneshot
RemainAfterExit=yes
ExecCondition=/usr/bin/grep -zqx retroidpocket,duo /sys/firmware/devicetree/base/compatible
ExecStart=/usr/libexec/armada/duo-usb-debug start
ExecStop=/usr/libexec/armada/duo-usb-debug stop
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
