[Unit]
Description=Retroid Pocket Duo WPSS bring-up test
After=local-fs.target systemd-modules-load.service sddm.service
RequiresMountsFor=/var/home/armada /var/lib/armada-duo-wpss
ConditionPathExists=/sys/firmware/devicetree/base/compatible
ConditionPathExists=!/var/lib/armada-duo-wpss/attempted-v1

[Service]
Type=oneshot
ExecCondition=/usr/bin/grep -zqx retroidpocket,duo /sys/firmware/devicetree/base/compatible
ExecStart=/usr/libexec/armada/duo-wpss-test
StateDirectory=armada-duo-wpss
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
