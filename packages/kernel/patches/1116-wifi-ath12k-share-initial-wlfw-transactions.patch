From: Armada <armada@armada.dev>
Subject: [PATCH] wifi: ath12k: share initial WLFW transactions with IPCI

Factor the indication-registration, host-capability and target-capability
transactions into one transport-independent helper. Reuse the existing
message definitions, timeout, response decoding and cancellation logic.
The existing callers retain their request construction, firmware result
checks and post-response handling. Only transport-error log wording
changes.

This lets an integrated transport perform the initial handshake without
allocating an ath12k hardware group or running PCI/IPQ initialization.

diff --git a/drivers/net/wireless/ath/ath12k/qmi.c b/drivers/net/wireless/ath/ath12k/qmi.c
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -2303,13 +2303,59 @@
 	return ret;
 }
 
+/* Keep transport-independent WLFW transactions usable before core setup. */
+int ath12k_qmi_wlfw_request(struct qmi_handle *handle, unsigned int msg_id,
+			    const void *req, void *resp)
+{
+	static const struct {
+		unsigned int id;
+		size_t len;
+		const struct qmi_elem_info *req_ei;
+		const struct qmi_elem_info *resp_ei;
+	} messages[] = {
+		{ QMI_WLANFW_IND_REGISTER_REQ_V01,
+		  QMI_WLANFW_IND_REGISTER_REQ_MSG_V01_MAX_LEN,
+		  qmi_wlanfw_ind_register_req_msg_v01_ei,
+		  qmi_wlanfw_ind_register_resp_msg_v01_ei },
+		{ QMI_WLANFW_HOST_CAP_REQ_V01,
+		  QMI_WLANFW_HOST_CAP_REQ_MSG_V01_MAX_LEN,
+		  qmi_wlanfw_host_cap_req_msg_v01_ei,
+		  qmi_wlanfw_host_cap_resp_msg_v01_ei },
+		{ QMI_WLANFW_CAP_REQ_V01,
+		  QMI_WLANFW_CAP_REQ_MSG_V01_MAX_LEN,
+		  qmi_wlanfw_cap_req_msg_v01_ei,
+		  qmi_wlanfw_cap_resp_msg_v01_ei },
+	};
+	struct qmi_txn txn;
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(messages); i++)
+		if (messages[i].id == msg_id)
+			break;
+	if (i == ARRAY_SIZE(messages))
+		return -EINVAL;
+
+	ret = qmi_txn_init(handle, &txn, messages[i].resp_ei, resp);
+	if (ret < 0)
+		return ret;
+
+	ret = qmi_send_request(handle, NULL, &txn, msg_id, messages[i].len,
+			       messages[i].req_ei, req);
+	if (ret < 0) {
+		qmi_txn_cancel(&txn);
+		return ret;
+	}
+
+	return qmi_txn_wait(&txn, msecs_to_jiffies(ATH12K_QMI_WLANFW_TIMEOUT_MS));
+}
+EXPORT_SYMBOL_GPL(ath12k_qmi_wlfw_request);
+
