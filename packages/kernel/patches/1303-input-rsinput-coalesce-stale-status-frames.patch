From: Armada <armada@armada.dev>
Subject: [PATCH] input: rsinput: coalesce stale status frames instead of replaying them

rsinput_rx() drains every complete frame buffered since the last callback
and reports each one to evdev in turn. CMD_STATUS carries the MCU's full,
absolute input state rather than a delta, so when several CMD_STATUS
frames have queued up (serdev callback scheduling delay, a busy CPU, etc.)
the driver replays every stale intermediate state before finally reporting
the current one. Each replayed frame is still correct, but the player only
feels the backlog drain as input lag bounded by how many frames rx_buf can
hold.

Hold back CMD_STATUS frames while draining a batch and only report the
last one seen before a non-status frame or the end of the batch. CMD_COMMOD
responses are unaffected and still reported in order. Log how many stale
status frames were dropped so the backlog can be sized/confirmed from the
journal alone, since the Duo cannot always be reached over SSH to run
tracing interactively.

--- a/drivers/input/joystick/rsinput.c
+++ b/drivers/input/joystick/rsinput.c
@@ -391,6 +391,9 @@
  */
 static size_t rsinput_rx(struct serdev_device *serdev, const u8 *data, size_t count) {
     struct rsinput_driver *drv = serdev_device_get_drvdata(serdev);
+    const uint8_t *pending_status = NULL;
+    size_t pending_status_len = 0;
+    unsigned int coalesced = 0;
     size_t consumed = 0, avail;
 
     if (!drv || !data || count == 0) {
@@ -430,15 +433,34 @@
         if (avail < frame_length)
             break;
 
-        if (compute_checksum(frame, frame_length) == frame[frame_length - 1])
-            rsinput_process_data(drv, frame, frame_length);
-        else
+        if (compute_checksum(frame, frame_length) == frame[frame_length - 1]) {
+            if (frame[FRAME_POS_CMD] == CMD_STATUS) {
+                if (pending_status)
+                    coalesced++;
+                pending_status = frame;
+                pending_status_len = frame_length;
+            } else {
+                if (pending_status) {
+                    rsinput_process_data(drv, pending_status, pending_status_len);
+                    pending_status = NULL;
+                }
+                rsinput_process_data(drv, frame, frame_length);
+            }
+        } else {
             dev_warn_ratelimited(&serdev->dev, "Checksum mismatch\n");
+        }
 
         consumed += frame_length;
         avail -= frame_length;
     }
 
+    if (pending_status)
+        rsinput_process_data(drv, pending_status, pending_status_len);
+
+    if (coalesced)
+        dev_info_ratelimited(&serdev->dev, "Dropped %u stale status frame(s) from RX backlog\n",
+                      coalesced);
+
     if (consumed) {
         memmove(drv->rx_buf, drv->rx_buf + consumed, avail);
         drv->rx_len = avail;
