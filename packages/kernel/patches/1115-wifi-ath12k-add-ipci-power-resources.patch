From: Armada <armada@armada.dev>
Subject: [PATCH] wifi: ath12k: add initial WCN7750 IPCI power resources

Introduce the power-resource part of an integrated WCN7750 transport.
Use devm_regulator_bulk_get_enable() for regulator acquisition, probe
failure unwind and release on detach. Require all four DT supply
phandles to prevent missing supplies becoming dummy regulators.

The supply mapping comes from the Duo Android FDT and matches the
regulators acquired by Qualcomm ICNSS2. Provider voltage constraints
remain in the board DTS; this module adds enable votes only.

The existing ath12k AHB implementation initializes IPQ hardware. Do not
reuse that probe path for WCN7750 or identify it as another chip. This
first increment does not start WPSS, send QMI messages, configure GPIOs,
allocate DMA memory or register a wireless interface. Keep it opt-in
and the board node disabled while the transport is developed.

Reference: OnePlusOSS/android_kernel_modules_and_devicetree_oneplus_sm8750,
  d50b305f7da9e14715a25120a4ac7b1a4b8b97c3,
  vendor/qcom/opensource/wlan/platform/icnss2/power.c.

diff --git a/Documentation/devicetree/bindings/net/wireless/qcom,wcn7750-wifi.yaml b/Documentation/devicetree/bindings/net/wireless/qcom,wcn7750-wifi.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/wireless/qcom,wcn7750-wifi.yaml
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/wireless/qcom,wcn7750-wifi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm WCN7750 integrated WLAN
+
+maintainers:
+  - Armada <armada@armada.dev>
+
+description:
+  Initial description of the host-controlled WLAN supplies. Firmware transport,
+  memory, interrupts and data-path resources are not described yet.
+
+properties:
+  compatible:
+    const: qcom,wcn7750-wifi
+
+  vdd-cx-mx-supply:
+    description: WLAN CX/MX supply
+
+  vdd-1.8-xo-supply:
+    description: WLAN oscillator supply
+
+  vdd-1.3-rfa-supply:
+    description: WLAN RF analog supply
+
+  vdd-1.8-io-supply:
+    description: WLAN I/O supply
+
+required:
+  - compatible
+  - vdd-cx-mx-supply
+  - vdd-1.8-xo-supply
+  - vdd-1.3-rfa-supply
+  - vdd-1.8-io-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    wifi {
+        compatible = "qcom,wcn7750-wifi";
+        vdd-cx-mx-supply = <&vreg_s3b>;
+        vdd-1.8-xo-supply = <&vreg_s1b>;
+        vdd-1.3-rfa-supply = <&vreg_s2b>;
+        vdd-1.8-io-supply = <&vreg_l11b>;
+    };
diff --git a/drivers/net/wireless/ath/ath12k/Kconfig b/drivers/net/wireless/ath/ath12k/Kconfig
--- a/drivers/net/wireless/ath/ath12k/Kconfig
+++ b/drivers/net/wireless/ath/ath12k/Kconfig
@@ -21,6 +21,18 @@
 	select QCOM_SCM
 	help
 	  Enable support for Ath12k AHB bus chipsets, example IPQ5332.
+
+config ATH12K_IPCI
+	tristate "Qualcomm ath12k IPCI power support (EXPERIMENTAL)"
+	depends on ATH12K && OF && REGULATOR
+	help
+	  Enable the initial power-resource support for integrated WCN7750
+	  WLAN devices. This currently acquires the WLAN regulator votes only;
+	  firmware initialization and the wireless data path are not implemented.
+
+	  If you choose to build a module, it'll be called ath12k_ipci.
+
+	  If unsure, say N.
 
 config ATH12K_DEBUG
 	bool "ath12k debugging"
diff --git a/drivers/net/wireless/ath/ath12k/Makefile b/drivers/net/wireless/ath/ath12k/Makefile
--- a/drivers/net/wireless/ath/ath12k/Makefile
+++ b/drivers/net/wireless/ath/ath12k/Makefile
@@ -24,6 +24,9 @@
 
 ath12k-$(CONFIG_ATH12K_AHB) += ahb.o
 
+obj-$(CONFIG_ATH12K_IPCI) += ath12k_ipci.o
+ath12k_ipci-y := ipci.o
+
 obj-$(CONFIG_ATH12K) += wifi7/
 
 ath12k-$(CONFIG_ATH12K_DEBUGFS) += debugfs.o debugfs_htt_stats.o debugfs_sta.o
diff --git a/drivers/net/wireless/ath/ath12k/ipci.c b/drivers/net/wireless/ath/ath12k/ipci.c
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/ath/ath12k/ipci.c
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+
+static const char * const ath12k_ipci_supplies[] = {
+	"vdd-cx-mx",
+	"vdd-1.8-xo",
+	"vdd-1.3-rfa",
+	"vdd-1.8-io",
+};
+
+static int ath12k_ipci_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *supply;
+	char property[32];
+	size_t i;
+	int ret;
+
+	/* An absent supply must not silently become a dummy regulator. */
+	for (i = 0; i < ARRAY_SIZE(ath12k_ipci_supplies); i++) {
+		snprintf(property, sizeof(property), "%s-supply",
+			 ath12k_ipci_supplies[i]);
+		supply = of_parse_phandle(dev->of_node, property, 0);
+		if (!supply)
+			return dev_err_probe(dev, -EINVAL, "invalid %s\n", property);
+		of_node_put(supply);
+	}
+
+	ret = devm_regulator_bulk_get_enable(dev, ARRAY_SIZE(ath12k_ipci_supplies),
+					     ath12k_ipci_supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable WLAN supplies\n");
+
+	dev_info(dev, "WLAN supply votes enabled; firmware initialization not implemented\n");
+
+	return 0;
+}
+
+static const struct of_device_id ath12k_ipci_of_match[] = {
+	{ .compatible = "qcom,wcn7750-wifi" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ath12k_ipci_of_match);
+
+static struct platform_driver ath12k_ipci_driver = {
+	.probe = ath12k_ipci_probe,
+	.driver = {
+		.name = "ath12k_ipci",
+		.of_match_table = ath12k_ipci_of_match,
+	},
+};
+module_platform_driver(ath12k_ipci_driver);
+
+MODULE_DESCRIPTION("Qualcomm ath12k IPCI WLAN power support");
+MODULE_LICENSE("Dual BSD/GPL");
