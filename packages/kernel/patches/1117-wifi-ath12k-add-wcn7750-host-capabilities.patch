From: Armada <armada@armada.dev>
Subject: [PATCH] wifi: ath12k: add WCN7750 host capability definitions

Add the missing DDR-type and GPIO-info host-capability TLVs using
Qualcomm's wire definitions. Existing callers leave these optional fields
unset. Describe the WPSS reference, DDR type, firmware GPIO mapping and
SW_CTRL pinctrl state in the WCN7750 binding.

These definitions are reusable by normal firmware initialization. This
patch does not start WPSS or add a diagnostic module parameter. The Duo
board properties are supplied separately in Armada's DTS, with WLAN still
disabled.

Reference: OnePlusOSS/android_kernel_modules_and_devicetree_oneplus_sm8750,
  d50b305f7da9e14715a25120a4ac7b1a4b8b97c3,
  vendor/qcom/opensource/wlan/platform/cnss_utils/
    wlan_firmware_service_v01.{c,h}.
  Board values: captured Duo Android FDT, /soc/qcom,wcn7750 and
  /memory/ddr_device_type.

diff --git a/Documentation/devicetree/bindings/net/wireless/qcom,wcn7750-wifi.yaml b/Documentation/devicetree/bindings/net/wireless/qcom,wcn7750-wifi.yaml
--- a/Documentation/devicetree/bindings/net/wireless/qcom,wcn7750-wifi.yaml
+++ b/Documentation/devicetree/bindings/net/wireless/qcom,wcn7750-wifi.yaml
@@ -10,12 +10,38 @@
   - Armada <armada@armada.dev>
 
 description:
-  Initial description of the host-controlled WLAN supplies. Firmware transport,
-  memory, interrupts and data-path resources are not described yet.
+  Host-controlled WLAN supplies and the initial WPSS firmware handshake.
+  Memory, interrupts and data-path resources are not described yet.
 
 properties:
   compatible:
     const: qcom,wcn7750-wifi
+
+  qcom,rproc:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: WPSS remote processor
+
+  qcom,ddr-type:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [7, 8]
+    description: Firmware DDR type code, 7 for LPDDR4 and 8 for LPDDR5
+
+  qcom,firmware-gpio-map:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 5
+    maxItems: 5
+    items:
+      maximum: 65535
+    description: |
+      Firmware GPIO identifiers in WLAN_EN, BT_EN, HOST_SOL, TARGET_SOL,
+      WLAN_SW_CTRL order. A value of 65535 means unspecified. These are
+      communicated to WPSS, not requested as Linux GPIO outputs.
+
+  pinctrl-names:
+    items:
+      - const: sw_ctrl
+
+  pinctrl-0: true
 
   vdd-cx-mx-supply:
     description: WLAN CX/MX supply
@@ -31,6 +57,11 @@
 
 required:
   - compatible
+  - qcom,rproc
+  - qcom,ddr-type
+  - qcom,firmware-gpio-map
+  - pinctrl-names
+  - pinctrl-0
   - vdd-cx-mx-supply
   - vdd-1.8-xo-supply
   - vdd-1.3-rfa-supply
@@ -42,6 +73,11 @@
   - |
     wifi {
         compatible = "qcom,wcn7750-wifi";
+        qcom,rproc = <&remoteproc_wpss>;
+        qcom,ddr-type = <7>;
+        qcom,firmware-gpio-map = <35 0xffff 33 32 81>;
+        pinctrl-names = "sw_ctrl";
+        pinctrl-0 = <&wlan_sw_ctrl>;
         vdd-cx-mx-supply = <&vreg_s3b>;
         vdd-1.8-xo-supply = <&vreg_s1b>;
         vdd-1.3-rfa-supply = <&vreg_s2b>;
diff --git a/drivers/net/wireless/ath/ath12k/qmi.c b/drivers/net/wireless/ath/ath12k/qmi.c
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -506,6 +506,51 @@
 		.tlv_type	= 0x27,
 		.offset		= offsetof(struct qmi_wlanfw_host_cap_req_msg_v01,
 					   feature_list),
+	},
+	{
+		.data_type	= QMI_OPT_FLAG,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u8),
+		.array_type	= NO_ARRAY,
+		.tlv_type	= 0x2C,
+		.offset		= offsetof(struct qmi_wlanfw_host_cap_req_msg_v01,
+					   ddr_type_valid),
+	},
+	{
+		.data_type	= QMI_UNSIGNED_4_BYTE,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u32),
+		.array_type	= NO_ARRAY,
+		.tlv_type	= 0x2C,
+		.offset		= offsetof(struct qmi_wlanfw_host_cap_req_msg_v01,
+					   ddr_type),
+	},
+	{
+		.data_type	= QMI_OPT_FLAG,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u8),
+		.array_type	= NO_ARRAY,
+		.tlv_type	= 0x2D,
+		.offset		= offsetof(struct qmi_wlanfw_host_cap_req_msg_v01,
+					   gpio_info_valid),
+	},
+	{
+		.data_type	= QMI_DATA_LEN,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u8),
+		.array_type	= NO_ARRAY,
+		.tlv_type	= 0x2D,
+		.offset		= offsetof(struct qmi_wlanfw_host_cap_req_msg_v01,
+					   gpio_info_len),
+	},
+	{
+		.data_type	= QMI_UNSIGNED_4_BYTE,
+		.elem_len	= QMI_WLFW_MAX_NUM_GPIO_INFO_V01,
+		.elem_size	= sizeof(u32),
+		.array_type	= VAR_LEN_ARRAY,
+		.tlv_type	= 0x2D,
+		.offset		= offsetof(struct qmi_wlanfw_host_cap_req_msg_v01,
+					   gpio_info),
 	},
 	{
 		.data_type	= QMI_EOTI,
diff --git a/drivers/net/wireless/ath/ath12k/qmi.h b/drivers/net/wireless/ath/ath12k/qmi.h
--- a/drivers/net/wireless/ath/ath12k/qmi.h
+++ b/drivers/net/wireless/ath/ath12k/qmi.h
@@ -158,7 +158,8 @@
 	struct dev_mem_info dev_mem[ATH12K_QMI_WLFW_MAX_DEV_MEM_NUM_V01];
 };
 
-#define QMI_WLANFW_HOST_CAP_REQ_MSG_V01_MAX_LEN		261
+#define QMI_WLANFW_HOST_CAP_REQ_MSG_V01_MAX_LEN		352
+#define QMI_WLFW_MAX_NUM_GPIO_INFO_V01			20
 #define QMI_WLANFW_HOST_CAP_REQ_V01			0x0034
 #define QMI_WLANFW_HOST_CAP_RESP_MSG_V01_MAX_LEN	7
 #define QMI_WLFW_HOST_CAP_RESP_V01			0x0034
@@ -258,7 +259,11 @@
 	struct wlfw_host_mlo_chip_info_s_v01 mlo_chip_info[QMI_WLFW_MAX_NUM_MLO_CHIPS_V01];
 	u8 feature_list_valid;
 	u64 feature_list;
-
