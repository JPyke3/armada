From: Armada <armada@armada.dev>
Subject: [PATCH] drm/msm/a6xx: give the A722 CP a user context record for preemption

msm passes 0 as the non-privileged save address and never sets the
matching restore address. A722's firmware uses both, so preempting a
render pass saves its state to address 0 and restores garbage: CCU
write faults at iova 0x0-0x2000 and tiles drawn in the wrong place.
Add ADRENO_QUIRK_PREEMPT_USER_RECORD and set it on A722: allocate a
192 KiB record per ring, as KGSL does, and program it for both save
and restore. GPUs without the quirk are unchanged.
---
--- a/drivers/gpu/drm/msm/adreno/adreno_gpu.h
+++ b/drivers/gpu/drm/msm/adreno/adreno_gpu.h
@@ -64,6 +64,8 @@
 #define ADRENO_QUIRK_4GB_VA			BIT(6)
 #define ADRENO_QUIRK_IFPC			BIT(7)
 #define ADRENO_QUIRK_SOFTFUSE			BIT(8)
+/* The CP saves and restores user state for preemption in a record */
+#define ADRENO_QUIRK_PREEMPT_USER_RECORD	BIT(9)
 
 /* Helper for formating the chip_id in the way that userspace tools like
  * crashdec expect.
--- a/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
@@ -1511,7 +1511,8 @@
 		.inactive_period = DRM_MSM_INACTIVE_PERIOD,
 		.quirks = ADRENO_QUIRK_HAS_CACHED_COHERENT |
 			  ADRENO_QUIRK_HAS_HW_APRIV |
-			  ADRENO_QUIRK_PREEMPTION,
+			  ADRENO_QUIRK_PREEMPTION |
+			  ADRENO_QUIRK_PREEMPT_USER_RECORD,
 		.funcs = &a7xx_gpu_funcs,
 		.a6xx = &(const struct a6xx_info) {
 			.hwcg = a730_hwcg,
--- a/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
@@ -454,10 +454,12 @@
 	OUT_RING(ring, upper_32_bits(
 		a6xx_gpu->preempt_iova[ring->id]));
 
-	/* user context buffer save, seems to be unnused by fw */
+	/* user context buffer save, 0 unless ADRENO_QUIRK_PREEMPT_USER_RECORD */
 	OUT_RING(ring, NON_PRIV_SAVE_ADDR);
-	OUT_RING(ring, 0);
-	OUT_RING(ring, 0);
+	OUT_RING(ring, lower_32_bits(
+		a6xx_gpu->preempt_user_iova[ring->id]));
+	OUT_RING(ring, upper_32_bits(
+		a6xx_gpu->preempt_user_iova[ring->id]));
 
 	OUT_RING(ring, COUNTER);
 	/* seems OK to set to 0 to disable it */
--- a/drivers/gpu/drm/msm/adreno/a6xx_gpu.h
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gpu.h
@@ -75,6 +75,8 @@
 	struct drm_gem_object *preempt_smmu_bo[MSM_GPU_MAX_RINGS];
 	void *preempt_smmu[MSM_GPU_MAX_RINGS];
 	uint64_t preempt_smmu_iova[MSM_GPU_MAX_RINGS];
+	struct drm_gem_object *preempt_user_bo[MSM_GPU_MAX_RINGS];
+	uint64_t preempt_user_iova[MSM_GPU_MAX_RINGS];
 	uint32_t last_seqno[MSM_GPU_MAX_RINGS];
 
 	atomic_t preempt_state;
@@ -198,6 +200,9 @@
 
 #define PREEMPT_SMMU_INFO_SIZE 4096
 
+/* Non-privileged context state the CP saves on preemption (KGSL's size) */
+#define PREEMPT_USER_RECORD_SIZE (192 * SZ_1K)
+
 #define PREEMPT_RECORD_SIZE(adreno_gpu) \
 	((adreno_gpu->info->preempt_record_size) == 0 ? \
 	 4192 * SZ_1K : (adreno_gpu->info->preempt_record_size))
--- a/drivers/gpu/drm/msm/adreno/a6xx_preempt.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_preempt.c
@@ -255,6 +255,11 @@
 		REG_A6XX_CP_CONTEXT_SWITCH_PRIV_NON_SECURE_RESTORE_ADDR,
 		a6xx_gpu->preempt_iova[ring->id], BIT(1), true);
 
+	if (a6xx_gpu->preempt_user_iova[ring->id])
+		a6xx_fenced_write(a6xx_gpu,
+			REG_A6XX_CP_CONTEXT_SWITCH_NON_PRIV_RESTORE_ADDR,
+			a6xx_gpu->preempt_user_iova[ring->id], BIT(1), true);
+
 	a6xx_gpu->next_ring = ring;
 
 	/* Start a timer to catch a stuck preemption */
@@ -322,6 +327,27 @@
 
 	struct a7xx_cp_smmu_info *smmu_info_ptr = ptr;
 
+	/*
+	 * The CP saves the preempted context's non-privileged state here and
+	 * restores it on resume. Without it, A722 saves to and restores from
+	 * address 0, corrupting the preempted render pass. GPUs without the
+	 * quirk keep the existing behaviour until they are tested with one.
+	 */
+	if (adreno_gpu->info->quirks & ADRENO_QUIRK_PREEMPT_USER_RECORD) {
+		ptr = msm_gem_kernel_new(gpu->dev, PREEMPT_USER_RECORD_SIZE,
+			MSM_BO_WC, gpu->vm, &bo, &iova);
+
+		if (IS_ERR(ptr))
+			return PTR_ERR(ptr);
+
+		memset(ptr, 0, PREEMPT_USER_RECORD_SIZE);
+
+		msm_gem_object_set_name(bo, "preempt_user_record ring%d", ring->id);
+
+		a6xx_gpu->preempt_user_bo[ring->id] = bo;
+		a6xx_gpu->preempt_user_iova[ring->id] = iova;
+	}
+
 	msm_iommu_pagetable_params(to_msm_vm(gpu->vm)->mmu, &ttbr, &asid);
 
 	smmu_info_ptr->magic = GEN7_CP_SMMU_INFO_MAGIC;
@@ -349,8 +375,10 @@
 	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
 	int i;
 
-	for (i = 0; i < gpu->nr_rings; i++)
+	for (i = 0; i < gpu->nr_rings; i++) {
 		msm_gem_kernel_put(a6xx_gpu->preempt_bo[i], gpu->vm);
+		msm_gem_kernel_put(a6xx_gpu->preempt_user_bo[i], gpu->vm);
+	}
 }
 
 void a6xx_preempt_init(struct msm_gpu *gpu)
