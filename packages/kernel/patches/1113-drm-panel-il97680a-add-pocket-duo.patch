+static void il97680a_write(struct panel_info *pinfo,
+			   struct mipi_dsi_multi_context *ctx,
+			   const u8 *data, size_t len)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	const struct mipi_dsi_host_ops *ops = dsi->host->ops;
+	struct mipi_dsi_msg msg = {
+		.channel = dsi->channel,
+		.type = MIPI_DSI_DCS_LONG_WRITE,
+		.flags = MIPI_DSI_MSG_USE_LPM,
+		.tx_len = len,
+		.tx_buf = data,
+	};
+	ssize_t ret;
+
+	if (ctx->accum_err)
+		return;
+
+	if (!pinfo->desc->vendor_dcs_long) {
+		mipi_dsi_dcs_write_buffer_multi(ctx, data, len);
+		return;
+	}
+
+	if (!ops || !ops->transfer) {
+		ctx->accum_err = -EOPNOTSUPP;
+		return;
+	}
+
+	ret = ops->transfer(dsi->host, &msg);
+	if (ret < 0) {
+		ctx->accum_err = ret;
+		dev_err(&dsi->dev, "Command %#x failed: %d\n",
+			data[0], ctx->accum_err);
+	}
+}
+
+#define il97680a_write_seq(pinfo, ctx, seq...) do { \
+	static const u8 data[] = { seq }; \
+	il97680a_write(pinfo, ctx, data, ARRAY_SIZE(data)); \
+} while (0)
+
 static int il97680a_rpnova_init_sequence(struct panel_info *pinfo)
 {
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
@@ -97,32 +152,38 @@
 
 	pinfo->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x08);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc8, 0x62);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x21);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xa4, 0x38);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x23);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x85, 0x15);
-
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x00);
+	il97680a_write_seq(pinfo, &dsi_ctx, 0xff, 0x5a, 0xa5, 0x08);
+	il97680a_write_seq(pinfo, &dsi_ctx, 0xc8, 0x62);
+	il97680a_write_seq(pinfo, &dsi_ctx, 0xff, 0x5a, 0xa5, 0x21);
+	il97680a_write_seq(pinfo, &dsi_ctx, 0xa4, 0x38);
+	il97680a_write_seq(pinfo, &dsi_ctx, 0xff, 0x5a, 0xa5, 0x23);
+	il97680a_write_seq(pinfo, &dsi_ctx, 0x85, 0x15);
+
+	il97680a_write_seq(pinfo, &dsi_ctx, 0xff, 0x5a, 0xa5, 0x00);
 	if (cur_vrefresh == 120) {
-		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x60, 0x00);
+		il97680a_write_seq(pinfo, &dsi_ctx, 0x60, 0x00);
 	} else {
-		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x60, 0x01);
-	}
-
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6d, 0x00);
-
-	mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
-
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+		il97680a_write_seq(pinfo, &dsi_ctx, 0x60, 0x01);
+	}
+
+	il97680a_write_seq(pinfo, &dsi_ctx, 0x6d, 0x00);
+
+	if (pinfo->desc->vendor_dcs_long)
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_TEAR_ON);
+	else
+		mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+
+	il97680a_write_seq(pinfo, &dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
 				     0x20);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+	il97680a_write_seq(pinfo, &dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
 				     0x0d, 0x75, 0x00, 0x00);
 
 	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
 
 	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	if (pinfo->desc->vendor_dcs_long)
+		return dsi_ctx.accum_err;
 
 	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
 
@@ -178,7 +239,100 @@
 				  MIPI_DSI_MODE_NO_EOT_PACKET |
 				  MIPI_DSI_MODE_LPM,
 	.init_sequence = il97680a_rpnova_init_sequence,
-};
+	.supplies = panel_supplies,
