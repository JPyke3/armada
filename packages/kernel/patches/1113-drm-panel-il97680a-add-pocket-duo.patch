Subject: [PATCH] drm/panel: ilitek-il97680a: add Pocket Duo bottom panel

Reuse the Nova initialization payloads, reset sequence and 120/60 Hz
timings, also used by RetroidPocket for the Duo bottom panel.
Use standard DCS helpers and finish the Duo command-mode initialization
in prepare, including RetroidPocket's post-display-on writes and delay.
Keep the Nova's video modes, VRR, power handling and brightness curve.

Use the three Android supplies in order with captured voltage/load votes
and delays. Keep shared L1G under normal regulator reference counting.
Duo brightness uses raw DBV without assuming the Nova luminance curve.

diff --git a/drivers/gpu/drm/panel/panel-ilitek-il97680a.c b/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
--- a/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
+++ b/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
@@ -33,6 +33,15 @@
 	struct drm_panel_bl_levels bl_levels;
 };
 
+struct il97680a_supply_config {
+	int min_uv;
+	int max_uv;
+	int load_ua;
+	int idle_load_ua;
+	unsigned int on_delay_ms;
+	unsigned int off_delay_ms;
+};
+
 struct panel_desc {
 	unsigned int width_mm;
 	unsigned int height_mm;
@@ -51,6 +60,11 @@
 	 * mode, which is the shortest frame AVR can run.
 	 */
 	unsigned int vrr_min_hz;
+	const struct regulator_bulk_data *supplies;
+	unsigned int num_supplies;
+	const struct il97680a_supply_config *supply_config;
+	bool needs_post_on;
+	bool raw_brightness;
 };
 
 static const struct regulator_bulk_data panel_supplies[] = {
@@ -126,7 +140,13 @@
 
 	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
 
-	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_msleep(&dsi_ctx, pinfo->desc->needs_post_on ? 50 : 20);
+
+	if (pinfo->desc->needs_post_on) {
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x22);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe1, 0x01);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x00);
+	}
 
 	return dsi_ctx.accum_err;
 }
@@ -178,7 +198,100 @@
 				  MIPI_DSI_MODE_NO_EOT_PACKET |
 				  MIPI_DSI_MODE_LPM,
 	.init_sequence = il97680a_rpnova_init_sequence,
-};
+	.supplies = panel_supplies,
+	.num_supplies = ARRAY_SIZE(panel_supplies),
+};
+
+static const struct regulator_bulk_data il97680a_rpduo_supplies[] = {
+	{ .supply = "vddio" },
+	{ .supply = "vci" },
+	{ .supply = "vdd" },
+};
+
+static const struct il97680a_supply_config il97680a_rpduo_supply_config[] = {
+	{ 1800000, 1800000, 220000, 8000, 20, 0 },
+	{ 3000000, 3544000, 10000, 300, 1, 2 },
+	{ 1200000, 1250000, 200000, 0, 0, 2 },
+};
+
+static struct panel_desc il97680a_rpduo_desc = {
+	.modes = il97680a_rpnova_modes,
+	.num_modes = ARRAY_SIZE(il97680a_rpnova_modes),
+	.bpc = 8,
+	.lanes = 4,
+	.format = MIPI_DSI_FMT_RGB888,
+	.mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS |
+		      MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_MODE_LPM,
+	.init_sequence = il97680a_rpnova_init_sequence,
+	.supplies = il97680a_rpduo_supplies,
+	.num_supplies = ARRAY_SIZE(il97680a_rpduo_supplies),
+	.supply_config = il97680a_rpduo_supply_config,
+	.needs_post_on = true,
+	.raw_brightness = true,
+};
+
+static int il97680a_power_off(struct panel_info *pinfo, unsigned int count)
+{
+	const struct il97680a_supply_config *config = pinfo->desc->supply_config;
+	int ret, err = 0;
+
+	if (!config)
+		return regulator_bulk_disable(count, pinfo->supplies);
+
+	while (count--) {
+		struct regulator *reg = pinfo->supplies[count].consumer;
+
+		ret = regulator_disable(reg);
+		if (ret) {
+			if (!err)
+				err = ret;
+			continue;
+		}
+		if (config[count].off_delay_ms)
+			msleep(config[count].off_delay_ms);
+		ret = regulator_set_load(reg, config[count].idle_load_ua);
+		if (ret < 0 && !err)
+			err = ret;
+	}
+
+	return err;
+}
+
+static int il97680a_power_on(struct panel_info *pinfo)
+{
+	const struct il97680a_supply_config *config = pinfo->desc->supply_config;
+	unsigned int i;
+	int ret, err;
+
+	if (!config)
+		return regulator_bulk_enable(pinfo->desc->num_supplies, pinfo->supplies);
+
+	for (i = 0; i < pinfo->desc->num_supplies; i++) {
+		struct regulator *reg = pinfo->supplies[i].consumer;
+
+		ret = regulator_set_voltage(reg, config[i].min_uv, config[i].max_uv);
+		if (ret < 0)
+			goto unwind;
+		ret = regulator_set_load(reg, config[i].load_ua);
+		if (ret < 0)
+			goto unwind;
+		ret = regulator_enable(reg);
+		if (ret < 0) {
+			regulator_set_load(reg, config[i].idle_load_ua);
+			goto unwind;
+		}
+		if (config[i].on_delay_ms)
+			msleep(config[i].on_delay_ms);
+	}
+
+	return 0;
+
+unwind:
+	err = il97680a_power_off(pinfo, i);
+	if (err)
+		dev_err(pinfo->panel.dev, "Failed to unwind supplies: %d\n", err);
+	return ret;
+}
 
 static void il97680a_reset(struct panel_info *pinfo)
 {
@@ -195,7 +308,7 @@
 	struct panel_info *pinfo = to_panel_info(panel);
 	int ret;
 
-	ret = regulator_bulk_enable(ARRAY_SIZE(panel_supplies), pinfo->supplies);
+	ret = il97680a_power_on(pinfo);
 	if (ret < 0) {
 		dev_err(panel->dev, "failed to enable regulators: %d\n", ret);
 		return ret;
@@ -205,7 +318,7 @@
 
 	ret = pinfo->desc->init_sequence(pinfo);
 	if (ret < 0) {
-		regulator_bulk_disable(ARRAY_SIZE(panel_supplies), pinfo->supplies);
+		il97680a_power_off(pinfo, pinfo->desc->num_supplies);
 		dev_err(panel->dev, "failed to initialize panel: %d\n", ret);
 		return ret;
 	}
@@ -218,7 +331,8 @@
 	struct panel_info *pinfo = to_panel_info(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
 
-	pinfo->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	if (pinfo->dsi->mode_flags & MIPI_DSI_MODE_VIDEO)
+		pinfo->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
 	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
 	mipi_dsi_msleep(&dsi_ctx, 20);
@@ -233,7 +347,7 @@
 	struct panel_info *pinfo = to_panel_info(panel);
 
 	gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
-	regulator_bulk_disable(ARRAY_SIZE(panel_supplies), pinfo->supplies);
+	il97680a_power_off(pinfo, pinfo->desc->num_supplies);
 
 	return 0;
 }
@@ -362,9 +476,11 @@
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
 	struct panel_info *pinfo = mipi_dsi_get_drvdata(dsi);
-	u16 brightness = drm_panel_bl_levels_map(&pinfo->bl_levels,
-						 backlight_get_brightness(bl));
+	u16 brightness = backlight_get_brightness(bl);
 	int ret;
+
+	if (!pinfo->desc->raw_brightness)
+		brightness = drm_panel_bl_levels_map(&pinfo->bl_levels, brightness);
 
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
@@ -390,11 +506,13 @@
 static struct backlight_device *il97680a_create_backlight(struct mipi_dsi_device *dsi)
 {
 	struct device *dev = &dsi->dev;
+	struct panel_info *pinfo = mipi_dsi_get_drvdata(dsi);
 	const struct backlight_properties props = {
 		.type = BACKLIGHT_RAW,
 		.brightness = 3445,
 		.max_brightness = 3445,
-		.scale = BACKLIGHT_SCALE_LINEAR,
+		.scale = pinfo->desc->raw_brightness ? BACKLIGHT_SCALE_UNKNOWN :
+			 BACKLIGHT_SCALE_LINEAR,
 	};
 
 	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
@@ -413,8 +531,12 @@
 	if (IS_ERR(pinfo))
 		return PTR_ERR(pinfo);
 
-	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(panel_supplies),
-					    panel_supplies, &pinfo->supplies);
+	pinfo->desc = (struct panel_desc *)of_device_get_match_data(dev);
+	if (!pinfo->desc)
+		return -ENODEV;
+
+	ret = devm_regulator_bulk_get_const(dev, pinfo->desc->num_supplies,
+					    pinfo->desc->supplies, &pinfo->supplies);
 	if (ret < 0) {
 		return dev_err_probe(dev, ret, "Failed to get regulators\n");
 	}
@@ -422,10 +544,6 @@
 	pinfo->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
 	if (IS_ERR(pinfo->reset_gpio))
 		return dev_err_probe(dev, PTR_ERR(pinfo->reset_gpio), "failed to get reset gpio\n");
-
-	pinfo->desc = (struct panel_desc *)of_device_get_match_data(dev);
-	if (!pinfo->desc)
-		return -ENODEV;
 
 	pinfo->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, pinfo);
@@ -438,11 +556,13 @@
 
 	pinfo->panel.prepare_prev_first = true;
 
-	ret = drm_panel_bl_levels_init(&pinfo->bl_levels, dev,
-				       il97680a_bl_levels,
-				       ARRAY_SIZE(il97680a_bl_levels), 13, 3445);
-	if (ret)
-		return dev_err_probe(dev, ret, "Failed to build backlight levels\n");
+	if (!pinfo->desc->raw_brightness) {
+		ret = drm_panel_bl_levels_init(&pinfo->bl_levels, dev,
+					       il97680a_bl_levels,
+					       ARRAY_SIZE(il97680a_bl_levels), 13, 3445);
+		if (ret)
+			return dev_err_probe(dev, ret, "Failed to build backlight levels\n");
+	}
 
 	pinfo->panel.backlight = il97680a_create_backlight(dsi);
 	if (IS_ERR(pinfo->panel.backlight))
@@ -467,6 +587,7 @@
 
 static const struct of_device_id il97680a_of_match[] = {
 	{ .compatible = "il97680a,rpnova", .data = &il97680a_rpnova_desc },
+	{ .compatible = "il97680a,rpduo", .data = &il97680a_rpduo_desc },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, il97680a_of_match);
