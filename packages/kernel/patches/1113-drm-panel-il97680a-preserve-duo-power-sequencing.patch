Subject: [PATCH] drm/panel: il97680a: preserve Pocket Duo supply sequencing

Duo support is already provided by the upstream candidate. Retain
Armada's ordered vddio/vci/vdd enables, captured voltage and load votes,
per-rail delays and reverse-order shutdown. Keep shared L1G under normal
regulator reference counting and unwind only successfully enabled rails.

Apply the existing power helpers to the candidate's variant data and
per-device supply count. Nova continues to use bulk regulator handling;
Duo keeps command mode and raw brightness.

---
diff --git a/drivers/gpu/drm/panel/panel-ilitek-il97680a.c b/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
--- a/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
+++ b/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
@@ -36,6 +36,15 @@
 	struct drm_panel_bl_levels bl_levels;
 };
 
+struct il97680a_supply_config {
+	int min_uv;
+	int max_uv;
+	int load_ua;
+	int idle_load_ua;
+	unsigned int on_delay_ms;
+	unsigned int off_delay_ms;
+};
+
 struct panel_desc {
 	unsigned int width_mm;
 	unsigned int height_mm;
@@ -57,6 +66,7 @@
 	bool linear_brightness;
 	unsigned long extra_mode_flags;
 	unsigned int vrr_min_hz;
+	const struct il97680a_supply_config *supply_config;
 };
 
 static const struct regulator_bulk_data il97680a_rpnova_supplies[] = {
@@ -68,9 +78,9 @@
 };
 
 static const struct regulator_bulk_data il97680a_rpduo_supplies[] = {
-	{ .supply = "vdd" },
 	{ .supply = "vddio" },
 	{ .supply = "vci" },
+	{ .supply = "vdd" },
 };
 
 static inline struct il97680a *to_il97680a(struct drm_panel *panel)
@@ -200,11 +210,81 @@
 	.vrr_min_hz = 80,
 };
 
+static const struct il97680a_supply_config il97680a_rpduo_supply_config[] = {
+	{ 1800000, 1800000, 220000, 8000, 20, 0 },
+	{ 3000000, 3544000, 10000, 300, 1, 2 },
+	{ 1200000, 1250000, 200000, 0, 0, 2 },
+};
+
 static const struct il97680a_variant il97680a_rpduo_variant = {
 	.desc = &il97680a_retroid_desc,
 	.supplies = il97680a_rpduo_supplies,
 	.num_supplies = ARRAY_SIZE(il97680a_rpduo_supplies),
-};
+	.supply_config = il97680a_rpduo_supply_config,
+};
+
+static int il97680a_power_off(struct il97680a *pinfo, unsigned int count)
+{
+	const struct il97680a_supply_config *config = pinfo->variant->supply_config;
+	int ret, err = 0;
+
+	if (!config)
+		return regulator_bulk_disable(count, pinfo->supplies);
+
+	while (count--) {
+		struct regulator *reg = pinfo->supplies[count].consumer;
+
+		ret = regulator_disable(reg);
+		if (ret) {
+			if (!err)
+				err = ret;
+			continue;
+		}
+		if (config[count].off_delay_ms)
+			msleep(config[count].off_delay_ms);
+		ret = regulator_set_load(reg, config[count].idle_load_ua);
+		if (ret < 0 && !err)
+			err = ret;
+	}
+
+	return err;
+}
+
+static int il97680a_power_on(struct il97680a *pinfo)
+{
+	const struct il97680a_supply_config *config = pinfo->variant->supply_config;
+	unsigned int i;
+	int ret, err;
+
+	if (!config)
+		return regulator_bulk_enable(pinfo->num_supplies, pinfo->supplies);
+
+	for (i = 0; i < pinfo->num_supplies; i++) {
+		struct regulator *reg = pinfo->supplies[i].consumer;
+
+		ret = regulator_set_voltage(reg, config[i].min_uv, config[i].max_uv);
+		if (ret < 0)
+			goto unwind;
+		ret = regulator_set_load(reg, config[i].load_ua);
+		if (ret < 0)
+			goto unwind;
+		ret = regulator_enable(reg);
+		if (ret < 0) {
+			regulator_set_load(reg, config[i].idle_load_ua);
+			goto unwind;
+		}
+		if (config[i].on_delay_ms)
+			msleep(config[i].on_delay_ms);
+	}
+
+	return 0;
+
+unwind:
+	err = il97680a_power_off(pinfo, i);
+	if (err)
+		dev_err(pinfo->panel.dev, "Failed to unwind supplies: %d\n", err);
+	return ret;
+}
 
 static void il97680a_reset(struct il97680a *pinfo)
 {
@@ -221,7 +301,7 @@
 	struct il97680a *pinfo = to_il97680a(panel);
 	int ret;
 
-	ret = regulator_bulk_enable(pinfo->num_supplies, pinfo->supplies);
+	ret = il97680a_power_on(pinfo);
 	if (ret < 0)
 		return ret;
 
@@ -230,7 +310,7 @@
 	ret = pinfo->desc->init_sequence(pinfo);
 	if (ret < 0) {
 		gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
-		regulator_bulk_disable(pinfo->num_supplies, pinfo->supplies);
+		il97680a_power_off(pinfo, pinfo->num_supplies);
 		return ret;
 	}
 
@@ -258,7 +338,7 @@
 	struct il97680a *pinfo = to_il97680a(panel);
 
 	gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
-	regulator_bulk_disable(pinfo->num_supplies, pinfo->supplies);
+	il97680a_power_off(pinfo, pinfo->num_supplies);
 
 	return 0;
 }
