From: Armada
Don't register a BV bin preamble on A722.

A722 has no BV pipe (no concurrent binning). Turnip registers the bin
restore preamble for BR, then a reduced one for BV that leaves out the
CCU and RB_BUFFER_CNTL/RB_CLEAR_TARGET state. On A722 the BV
registration replaces the BR one, so when gamescope's realtime queue
preempts a game between GMEM bins, the bin resumes with whatever
RB_BUFFER_CNTL the compositor left (render targets in sysmem). The
tile is then written to the GMEM pass's sysmem base, 0: CCU write
faults at iova 0x0-0x2000 and stale tiles flickering on screen, most
visibly with the perf overlay and QAM composited over Mina the Hollower.

Mark A722 as having no BV pipe and register only the BR preamble.
--- a/src/freedreno/common/freedreno_dev_info.h
+++ b/src/freedreno/common/freedreno_dev_info.h
@@ -427,6 +427,11 @@ struct fd_dev_info {
        */
       bool storage_ubwc_internal_quirk;
 
+      /* The GPU has no BV pipe (no concurrent binning), so state set for
+       * the BV thread lands on BR instead.
+       */
+      bool no_bv;
+
       /* Whether CP_ALWAYS_ON_COUNTER only resets on device loss rather than
        * on every suspend/resume.
        */
--- a/src/freedreno/common/freedreno_devices.py
+++ b/src/freedreno/common/freedreno_devices.py
@@ -997,7 +997,8 @@ add_gpus([
         GPUId(chip_id=0xffff43020100, name="Adreno (TM) 722"),
     ], A6xxGPUInfo(
         CHIP.A7XX,
-        [a7xx_base, a7xx_gen1, GPUProps(storage_ubwc_internal_quirk = True)],
+        [a7xx_base, a7xx_gen1, GPUProps(storage_ubwc_internal_quirk = True,
+                                        no_bv = True)],
         num_ccu = 2,
         tile_align_w = 64,
         tile_align_h = 32,
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -2494,14 +2494,20 @@ tu_init_hw(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
                   CP_SET_AMBLE_2_TYPE(BIN_PREAMBLE_AMBLE_TYPE));
 
    if (CHIP >= A7XX) {
-      tu7_thread_control(cs, CP_SET_THREAD_BV);
+      /* Without a BV pipe the BV amble replaces the BR one, and the GPU
+       * restores bins without the CCU and RB_BUFFER_CNTL state after a
+       * preemption.
+       */
+      if (!cmd->device->physical_device->info->props.no_bv) {
+         tu7_thread_control(cs, CP_SET_THREAD_BV);
 
-      tu_cs_emit_pkt7(cs, CP_SET_AMBLE, 3);
-      tu_cs_emit_qw(cs, cmd->device->bin_preamble_bv_entry.bo->iova +
-                        cmd->device->bin_preamble_bv_entry.offset);
-      tu_cs_emit(cs, CP_SET_AMBLE_2_DWORDS(cmd->device->bin_preamble_bv_entry.size /
-                                           sizeof(uint32_t)) |
-                     CP_SET_AMBLE_2_TYPE(BIN_PREAMBLE_AMBLE_TYPE));
+         tu_cs_emit_pkt7(cs, CP_SET_AMBLE, 3);
+         tu_cs_emit_qw(cs, cmd->device->bin_preamble_bv_entry.bo->iova +
+                           cmd->device->bin_preamble_bv_entry.offset);
+         tu_cs_emit(cs, CP_SET_AMBLE_2_DWORDS(cmd->device->bin_preamble_bv_entry.size /
+                                              sizeof(uint32_t)) |
+                        CP_SET_AMBLE_2_TYPE(BIN_PREAMBLE_AMBLE_TYPE));
+      }
 
       tu7_thread_control(cs, CP_SET_THREAD_BOTH);
 
