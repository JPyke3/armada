From: Armada
Disable UBWC on A722 internal storage images.

With UBWC on storage images, A722 renders flashing black blocks
(Megabonk, native and under FEX). num_ccu, the A730 magic regs, cache
flushes and sysmem rendering don't fix it; dropping UBWC does.

Images with an explicit DRM modifier keep UBWC. They're shared, like
gamescope's composite, which the DPU can only rotate when it's UBWC.
--- a/src/freedreno/common/freedreno_dev_info.h
+++ b/src/freedreno/common/freedreno_dev_info.h
@@ -421,6 +421,12 @@
        */
       bool ubwc_coherency_quirk;

+      /* a722 corrupts UBWC storage images in blocks. Only images with an
+       * explicit DRM modifier, which are shared with other processes or the
+       * display, may use UBWC.
+       */
+      bool storage_ubwc_internal_quirk;
+
       /* Whether CP_ALWAYS_ON_COUNTER only resets on device loss rather than
        * on every suspend/resume.
        */
--- a/src/freedreno/common/freedreno_devices.py
+++ b/src/freedreno/common/freedreno_devices.py
@@ -997,7 +997,7 @@
         GPUId(chip_id=0xffff43020100, name="Adreno (TM) 722"),
     ], A6xxGPUInfo(
         CHIP.A7XX,
-        [a7xx_base, a7xx_gen1],
+        [a7xx_base, a7xx_gen1, GPUProps(storage_ubwc_internal_quirk = True)],
         num_ccu = 1,
         tile_align_w = 64,
         tile_align_h = 16,
--- a/src/freedreno/vulkan/tu_image.cc
+++ b/src/freedreno/vulkan/tu_image.cc
@@ -666,6 +666,12 @@
       }
    }

+   if ((pCreateInfo->usage & VK_IMAGE_USAGE_STORAGE_BIT) &&
+       modifier == DRM_FORMAT_MOD_INVALID &&
+       device->physical_device->info->props.storage_ubwc_internal_quirk) {
+      ubwc_enabled = false;
+   }
+
    if (TU_DEBUG(NOUBWC)) {
       ubwc_enabled = false;
    }
